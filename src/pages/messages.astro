---
import "../styles/global.css";
import AuthModal from "../components/AuthModal.astro";
import Footer from "../components/Footer.astro";
import MessagesApp from "../components/messages/MessagesApp";
import Nav from "../components/Nav.astro";

const site = "https://paddlme.tech/messages";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>Messages — Paddlme</title>
    <meta
      name="description"
      content="Chat with Paddlme renters and equipment owners."
    />
    <link rel="canonical" href={site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#f6f8f9] font-sans text-ink antialiased">
    <Nav variant="solid" />

    <main class="mx-auto min-h-[72vh] max-w-[1240px] px-4 pb-14 pt-28 sm:px-6">
      <header class="mb-6 flex items-end justify-between gap-4">
        <div>
          <h1 class="mt-1 text-[30px] font-extrabold tracking-[-0.03em] text-ocean-950">
            Messages
          </h1>
        </div>
        <a
          href="/browse"
          class="hidden rounded-full border border-line bg-white px-4 py-2.5 text-sm font-bold text-ink no-underline transition-colors hover:bg-[#f6f8f9] sm:inline-flex"
        >
          Browse gear
        </a>
      </header>

      <MessagesApp client:load />
    </main>

    <Footer />
    <AuthModal />
  </body>
</html>

<style is:global>
  @media (max-width: 767px) {
    #messages-layout[data-view="list"] #messages-thread {
      display: none;
    }

    #messages-layout[data-view="thread"] #messages-inbox {
      display: none;
    }

    #messages-layout[data-view="thread"] #messages-thread {
      display: flex;
    }
  }

  @media (min-width: 768px) {
    #messages-layout #messages-inbox,
    #messages-layout #messages-thread {
      display: flex;
    }
  }
</style>
