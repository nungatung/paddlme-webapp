---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AuthModal from '../components/AuthModal.astro';

const site = 'https://paddlme.tech/about';

const reasons = [
  {
    title: 'Verified before you book',
    body: 'Everyone confirms their ID with an ID Verification + Liveness Check. To confirm every user is who they say they are, so you can trust who you are renting from and renting to.',
    icon: '/verified.svg',
  },
  {
    title: 'Waste reduction',
    body: 'Instead of buying new, rather opt for renting locally to strive towards a more sustainable future.',
    icon: '/recycle.svg',
  },
  {
    title: 'Reviews both ways',
    body: 'Backed by two way ratings and reviews so all users can share their experience and build a history of trust.',
    icon: '/handshake.svg',
  },
  {
    title: 'Money stays local',
    body: 'Supports the local with peer-to-peer rentals within the community.',
    icon: '/cash.svg',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>Our Purpose | Building a Trusted Sharing Community</title>
    <meta
      name="description"
      content="Why Paddlme exists: peer-to-peer water sports rental in New Zealand, with identity verification and a recorded safety handover on every booking."
    />
    <link rel="canonical" href={site} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-white font-sans text-ink antialiased">
    <Nav />

    <section class="reveal-fade relative">
      <img
        src="/jetski-4.webp"
        alt="A rider on a red jet ski carving across the water"
        class="h-[420px] w-full object-cover object-[center_60%] sm:h-[520px]"
      />
    </section>

    <main class="mx-auto max-w-[880px] px-8 pb-32 pt-16">
      <h1
        class="reveal text-[32px] font-semibold leading-tight tracking-[-0.015em] text-ocean-950 sm:text-[42px]"
      >
        Our purpose
      </h1>
      <p class="reveal mt-6 text-[17px] leading-[1.8] text-ink [--reveal-delay:100ms]">
        Our goal for Paddlme is to cultivate a trusted community-driven marketplace where people can connect and share equipment whilst saving money and earning extra income. And in doing so, create a sharing economy that benefits all parties involved. 
      </p>

      <div class="mt-28 grid grid-cols-1 gap-x-24 gap-y-16 sm:grid-cols-2">
        <section class="reveal">
          <h2
            class="text-[30px] font-semibold leading-tight tracking-[-0.015em] text-ocean-950 sm:text-[38px]"
          >
            Our vision
          </h2>
          <p class="mt-5 text-[16px] leading-[1.75] text-ink">
            We envision a world where people can connect and share equipment with ease and confidence, fostering a sustainable, cost effective and thriving community.
          </p>
        </section>
        <section class="reveal [--reveal-delay:120ms]">
          <h2
            class="text-[30px] font-semibold leading-tight tracking-[-0.015em] text-ocean-950 sm:text-[38px]"
          >
            Our goal
          </h2>
          <p class="mt-5 text-[16px] leading-[1.75] text-ink">
            To create a seamless and trustworthy experience, where everyone can connect with confidence. Through rigorous ID verification, transparent communication, and a commitment to safety, we aim to make sharing simple, secure, and accessible for everyone.
          </p>
        </section>
      </div>

      <section class="mt-32">
        <h2
          class="reveal text-[30px] font-semibold leading-tight tracking-[-0.015em] text-ocean-950 sm:text-[38px]"
        >
          Why Paddlme?
        </h2>
        <p class="reveal mt-5 text-[16px] leading-[1.75] text-ink [--reveal-delay:100ms]">
          Building trust in the sharing economy is only possible through transparency, security, and mutual respect. These are the fundamentals that make peer-to-peer sharing safe and enjoyable for everyone involved.
        </p>

        <div
          class="mt-16 grid grid-cols-1 gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-4"
        >
          {
            reasons.map((reason, index) => (
              <div
                class="reveal"
                style={`--reveal-delay: ${index * 100}ms`}
              >
                <img
                  src={reason.icon}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  class="h-15 w-15"
                />
                <h3 class="mt-6 text-[18px] font-bold text-ink">{reason.title}</h3>
                <p class="mt-2.5 text-[16px] leading-[1.7] text-ink">{reason.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <p class="reveal mt-32 text-[16px] leading-[1.75] text-ink">
        Come aboard and join us on this exciting journey as we work together to make peer-to-peer sharing safe and seamless. Let's get out there!
      </p>
    </main>

    <Footer />

    <AuthModal />

    <script>
      const revealed = document.querySelectorAll('.reveal, .reveal-fade');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -48px 0px' },
        );
        revealed.forEach((el) => io.observe(el));
      } else {
        revealed.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>