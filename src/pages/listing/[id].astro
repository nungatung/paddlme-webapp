      class="auth-overlay fixed inset-0 z-50 hidden overflow-y-auto bg-ocean-950/60 backdrop-blur-[2px]"
      role="dialog"
      aria-modal="true"
    >
      <div class="flex min-h-full items-center justify-center p-4">
        <div class="auth-card relative w-full max-w-[460px] overflow-hidden rounded-2xl bg-white p-6 shadow-2xl">
          <div class="flex items-center justify-between border-b border-line pb-3">
            <h3 class="text-lg font-extrabold text-ocean-950">Message Host</h3>
            <button
              type="button"
