---
import "../../styles/global.css";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import AuthModal from "../../components/AuthModal.astro";
import { db } from "../../lib/firebase";
import { collection, getDocs } from "firebase/firestore";

export async function getStaticPaths() {
  try {
    const snap = await getDocs(collection(db, "equipment"));
    const paths = snap.docs.map((doc) => ({
      params: { id: doc.id },
      props: {
        initialListing: {
          id: doc.id,
          ...doc.data(),
        },
      },
    }));
    if (paths.length > 0) return paths;
  } catch (error) {
    console.warn("Could not pre-fetch listings at build time:", error);
  }
  return [{ params: { id: "preview" }, props: { initialListing: null } }];
}

interface Props {
  initialListing?: any;
}

const { id } = Astro.params;
const { initialListing } = Astro.props;

const site = `https://paddlme.tech/listing/${id}`;
const mapboxToken =
  import.meta.env.PUBLIC_MAP_BOX_TOKEN ||
  import.meta.env.MAP_BOX_TOKEN ||
  import.meta.env.PUBLIC_MAPBOX_TOKEN ||
  "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>{initialListing?.title ? `${initialListing.title} — Paddlme` : 'Equipment Rental — Paddlme'}</title>
    <meta
      name="description"
      content={
        initialListing?.description ||
        "Rent water sports gear from verified locals in New Zealand on Paddlme."
      }
    />
    <link rel="canonical" href={site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- Mapbox GL JS & CSS -->
    <link
      href="https://api.mapbox.com/mapbox-gl-js/v3.9.4/mapbox-gl.css"
      rel="stylesheet"
    />
    <script
      is:inline
      src="https://api.mapbox.com/mapbox-gl-js/v3.9.4/mapbox-gl.js"
    ></script>
  </head>

  <body
    class="bg-white font-sans text-ink antialiased"
    data-listing-id={id}
    data-mapbox-token={mapboxToken}
  >
    <Nav variant="solid" />

    <main class="mx-auto max-w-[1240px] px-4 pb-24 pt-24 sm:px-6 sm:pt-28">
      <!-- Back Link & Breadcrumb -->
      <div class="mb-5 flex items-center justify-between">
        <a
          href="/browse"
          class="inline-flex items-center gap-2 rounded-xl py-1.5 text-sm font-bold text-muted transition-colors hover:text-ink no-underline"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          Back to gear
        </a>

        <div class="hidden items-center gap-2 text-xs font-semibold text-muted sm:flex">
          <span>Home</span>
          <span>/</span>
          <a href="/browse" class="hover:text-ink no-underline text-muted">
            Browse
          </a>
          <span>/</span>
          <span class="text-ink truncate max-w-[240px]" id="breadcrumb-title">
            {initialListing?.title || "Listing"}
          </span>
        </div>
      </div>

      <!-- Loading Skeleton (hidden once data rendered) -->
      <div id="listing-skeleton" class="animate-pulse space-y-6">
        <div class="h-9 w-1/2 rounded-xl bg-gray-200"></div>
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.55fr_1fr]">
          <div class="space-y-4">
            <div class="aspect-[4/3] w-full rounded-2xl bg-gray-200 sm:aspect-[16/10]"></div>
            <div class="flex gap-2">
              <div class="h-20 w-24 rounded-xl bg-gray-200"></div>
              <div class="h-20 w-24 rounded-xl bg-gray-200"></div>
              <div class="h-20 w-24 rounded-xl bg-gray-200"></div>
            </div>
            <div class="h-32 rounded-2xl bg-gray-200"></div>
            <div class="h-56 rounded-2xl bg-gray-200"></div>
          </div>
          <div class="space-y-4">
            <div class="h-96 rounded-2xl bg-gray-200"></div>
            <div class="h-28 rounded-2xl bg-gray-200"></div>
          </div>
        </div>
      </div>

      <!-- Listing Content -->
      <div id="listing-content" class="hidden space-y-6">
        <!-- Title & Header Bar -->
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
          <div>
            <h1
              id="listing-title"
              class="text-[26px] font-extrabold tracking-[-0.02em] text-ocean-950 sm:text-[32px] leading-tight"
            >
              {initialListing?.title || "Loading equipment…"}
            </h1>
            <p
              id="listing-category-text"
              class="mt-1 text-sm font-semibold text-muted capitalize"
            >
              Water sports gear
            </p>
          </div>

          <!-- Share Button -->
          <button
            type="button"
            id="share-btn"
            title="Share this listing"
            class="self-start grid h-10 w-10 place-items-center rounded-full border border-line bg-white text-muted hover:border-ocean-500 hover:text-ink transition-colors cursor-pointer shadow-sm"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </button>
        </div>

        <!-- 2-Column Main Layout matching reference structure -->
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.55fr_1fr] lg:items-start">
          <!-- LEFT COLUMN: Imagery, Price bar, Description, Map, Availability, Security -->
          <div class="space-y-7">
            <!-- Photos Showcase -->
            <div class="space-y-3">
              <div class="relative overflow-hidden rounded-2xl border border-line bg-[#f8f9fa] shadow-sm">
                <img
                  id="listing-main-image"
                  src={initialListing?.imageUrls?.[0] || "/jetskiing.webp"}
                  alt=""
                  class="aspect-[4/3] w-full object-cover sm:aspect-[16/10] transition-opacity duration-200"
                />
                <div
                  id="gallery-count"
                  class="absolute bottom-3 right-3 rounded-full bg-black/60 px-3 py-1 text-xs font-semibold text-white backdrop-blur-sm"
                >
                  Photo 1 of 1
                </div>
              </div>

              <!-- Thumbnails Row -->
              <div
                id="listing-thumbnails"
                class="flex gap-2.5 overflow-x-auto pb-1"
              >
                <!-- Populated dynamically -->
              </div>
            </div>

            <!-- Price Row Strip (clean, like reference) -->
            <div class="flex items-center justify-between border-y border-line py-3.5 text-sm">
              <span class="font-bold text-ocean-950">Rental Rate</span>
              <span
                id="price-row-text"
                class="font-extrabold text-accent text-base"
              >
                NZ$0 / hour
              </span>
            </div>

            <!-- Description -->
            <div class="space-y-2.5">
              <h2 class="text-[17px] font-extrabold text-ocean-950">
                Description
              </h2>
              <p
                id="listing-description"
                class="whitespace-pre-line text-[15px] leading-relaxed text-ink/80"
              >
                No description provided.
              </p>
            </div>

            <!-- Features / What's Included -->
            <div id="features-container" class="space-y-2.5 hidden">
              <h2 class="text-[17px] font-extrabold text-ocean-950">
                What's included
              </h2>
              <div id="listing-features-grid" class="flex flex-wrap gap-2">
                <!-- Injected features -->
              </div>
            </div>

            <!-- Location with Mapbox Map (matches reference screenshot) -->
            <div class="space-y-2.5">
              <div class="flex items-center justify-between">
                <h2 class="text-[17px] font-extrabold text-ocean-950">
                  Location
                </h2>
                <span
                  id="location-name-badge"
                  class="text-xs font-semibold text-muted"
                >
                  New Zealand
                </span>
              </div>
              <p class="text-xs text-muted">
                General area shown for host privacy. Exact pickup location is
                provided once your booking is accepted.
              </p>

              <!-- Map Container -->
              <div class="relative h-[290px] w-full overflow-hidden rounded-2xl border border-line bg-[#f0f3f5] shadow-sm">
                <div id="listing-map" class="h-full w-full"></div>

                <!-- Recenter button -->
                <button
                  type="button"
                  id="map-recenter-btn"
                  title="Recenter"
                  class="absolute right-3 top-3 z-[10] grid h-8 w-8 place-items-center rounded-lg border border-line/60 bg-white shadow-sm hover:bg-[#f6f8f9] cursor-pointer"
                >
                  <svg
                    class="h-4 w-4 text-ink"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Availability Schedule (matching reference) -->
            <div class="space-y-2.5">
              <h2 class="text-[17px] font-extrabold text-ocean-950">
                Standard Availability
              </h2>
              <div class="rounded-xl border border-line/70 bg-[#fafafa] p-4 divide-y divide-line/60 text-xs">
                <div class="flex justify-between py-2 font-medium">
                  <span class="text-ink">Monday – Friday</span>
                  <span class="text-muted font-semibold">
                    08:00 AM – 06:00 PM
                  </span>
                </div>
                <div class="flex justify-between py-2 font-medium">
                  <span class="text-ink">Saturday – Sunday</span>
                  <span class="text-muted font-semibold">
                    07:00 AM – 07:00 PM
                  </span>
                </div>
              </div>
            </div>

            <!-- Verification & Security Section (matching reference) -->
            <div class="space-y-2.5">
              <h2 class="text-[17px] font-extrabold text-ocean-950">
                Verification & Security
              </h2>
              <p class="text-xs text-muted">
                To hire this gear, the following checks apply:
              </p>

              <div class="rounded-xl border border-line/70 bg-[#fafafa] p-4 space-y-3 text-xs leading-relaxed">
                <div class="flex items-start gap-2.5">
                  <svg
                    class="h-4 w-4 text-emerald-600 shrink-0 mt-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 6L9 17l-5-5"></path>
                  </svg>
                  <span>
                    A valid New Zealand driver's licence or passport verified
                    before first booking.
                  </span>
                </div>
                <div class="flex items-start gap-2.5">
                  <svg
                    class="h-4 w-4 text-emerald-600 shrink-0 mt-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 6L9 17l-5-5"></path>
                  </svg>
                  <span>
                    Refundable security deposit is placed as a card hold (not
                    charged). It is automatically released once the host marks
                    the gear returned.
                  </span>
                </div>
                <div class="flex items-start gap-2.5">
                  <svg
                    class="h-4 w-4 text-emerald-600 shrink-0 mt-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 6L9 17l-5-5"></path>
                  </svg>
                  <span>
                    Safety checklist run at handover: both parties verify
                    condition and submit a unique 6-digit handover code.
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT COLUMN: Sticky Booking Box + Host Info Card -->
          <div class="lg:sticky lg:top-28 space-y-4">
            <!-- Booking Card Container -->
            <div class="rounded-2xl border border-line bg-white p-6 shadow-[0_12px_36px_rgba(0,37,58,0.08)] space-y-5">
              <div>
                <label class="block text-xs font-bold text-ocean-950 uppercase tracking-wider mb-1.5">
                  Rental date
                </label>
                <div class="relative" id="booking-date-dropdown-wrapper">
                  <input type="hidden" id="booking-date" />
                  <button
                    type="button"
                    id="booking-date-picker-btn"
                    class="flex h-11 w-full items-center justify-between gap-2 rounded-xl border border-line bg-white px-3.5 text-left text-sm font-semibold text-ink shadow-sm transition-colors hover:border-ocean-500 cursor-pointer"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-controls="booking-date-menu"
                  >
                    <span class="flex min-w-0 items-center gap-2.5">
                      <svg class="h-4 w-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                        <path d="M16 3v4M8 3v4M3 11h18"></path>
                      </svg>
                      <span id="booking-date-picker-label">Choose a date</span>
                    </span>
                    <svg id="booking-date-picker-chevron" class="h-3.5 w-3.5 shrink-0 text-muted transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                      <path d="m6 9 6 6 6-6"></path>
                    </svg>
                  </button>
                  <div
                    id="booking-date-menu"
                    class="absolute left-0 top-[calc(100%+8px)] z-40 hidden w-full min-w-[280px] overflow-hidden rounded-2xl border border-line bg-white shadow-[0_16px_40px_rgba(0,37,58,0.16)]"
                    role="dialog"
                    aria-label="Choose rental date"
                  >
                    <div class="flex items-center justify-between border-b border-line/80 px-4 py-3.5">
                      <button type="button" id="booking-calendar-prev" class="grid h-8 w-8 place-items-center rounded-full text-muted transition-colors hover:bg-[#f6f8f9] hover:text-ink cursor-pointer" aria-label="Previous month">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
                      </button>
                      <span id="booking-calendar-month" class="text-[15px] font-extrabold tracking-[-0.01em] text-ocean-950"></span>
                      <button type="button" id="booking-calendar-next" class="grid h-8 w-8 place-items-center rounded-full text-muted transition-colors hover:bg-[#f6f8f9] hover:text-ink cursor-pointer" aria-label="Next month">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                      </button>
                    </div>
                    <div class="grid grid-cols-7 gap-1 px-3 pt-3 text-center text-[11px] font-bold uppercase tracking-wide text-muted" aria-hidden="true">
                      <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                    </div>
                    <div id="booking-calendar-days" class="grid grid-cols-7 gap-1 p-3 pt-2"></div>
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label for="booking-start-time-btn" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-ocean-950">
                    Start time
                  </label>
                  <div class="relative" id="booking-start-time-wrapper">
                    <button type="button" id="booking-start-time-btn" class="flex h-10 w-full items-center justify-between gap-1 rounded-xl border border-line bg-white px-3 text-xs font-semibold text-ink shadow-sm transition-colors hover:border-ocean-500 cursor-pointer" aria-haspopup="listbox" aria-expanded="false" aria-controls="booking-start-time-menu">
                      <span id="booking-start-time-label">9:00 AM</span>
                      <svg class="h-3.5 w-3.5 shrink-0 text-muted transition-transform duration-200" id="booking-start-time-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                    </button>
                    <input type="hidden" id="booking-start-time" value="09:00" />
                    <div id="booking-start-time-menu" class="absolute left-0 top-[calc(100%+8px)] z-40 hidden w-40 overflow-hidden rounded-2xl border border-line bg-white shadow-[0_16px_40px_rgba(0,37,58,0.16)]" role="listbox" aria-label="Choose start time">
                      <div class="border-b border-line/80 px-4 py-3 text-sm font-extrabold text-ocean-950">Start time</div>
                      <div id="booking-start-time-options" class="max-h-56 overflow-y-auto p-2"></div>
                    </div>
                  </div>
                </div>
                <div>
                  <label for="booking-end-time-btn" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-ocean-950">
                    End time
                  </label>
                  <div class="relative" id="booking-end-time-wrapper">
                    <button type="button" id="booking-end-time-btn" class="flex h-10 w-full items-center justify-between gap-1 rounded-xl border border-line bg-white px-3 text-xs font-semibold text-ink shadow-sm transition-colors hover:border-ocean-500 cursor-pointer" aria-haspopup="listbox" aria-expanded="false" aria-controls="booking-end-time-menu">
                      <span id="booking-end-time-label">1:00 PM</span>
                      <svg class="h-3.5 w-3.5 shrink-0 text-muted transition-transform duration-200" id="booking-end-time-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                    </button>
                    <input type="hidden" id="booking-end-time" value="13:00" />
                    <div id="booking-end-time-menu" class="absolute right-0 top-[calc(100%+8px)] z-40 hidden w-40 overflow-hidden rounded-2xl border border-line bg-white shadow-[0_16px_40px_rgba(0,37,58,0.16)]" role="listbox" aria-label="Choose end time">
                      <div class="border-b border-line/80 px-4 py-3 text-sm font-extrabold text-ocean-950">End time</div>
                      <div id="booking-end-time-options" class="max-h-56 overflow-y-auto p-2"></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Price Box with White Background & Subtext (like screenshot) -->
              <div class="rounded-xl border border-line bg-[#f8f9fa] p-4 text-center space-y-1.5">
                <p
                  id="calc-headline"
                  class="text-[20px] font-extrabold text-ocean-950"
                >
                  NZ$0 (4 hours)
                </p>
                <p id="calc-subtext" class="text-xs text-muted leading-relaxed">
                  Price calculated per hour of rental. You will only be charged
                  after the host accepts.
                </p>
              </div>

              <!-- Request to Book Button (Paddlme Accent) -->
              <button
                type="button"
                id="request-booking-btn"
                class="w-full cursor-pointer rounded-full bg-accent py-3.5 text-sm font-extrabold text-white shadow-md shadow-accent/25 hover:brightness-95 active:scale-[0.99] transition-all text-center"
              >
                Request to book
              </button>
            </div>

            <!-- Host Card (directly beneath booking card, matching screenshot) -->
            <div class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between">
              <div class="flex items-center gap-3 min-w-0">
                <div
                  id="host-avatar"
                  class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-ocean-500/10 font-brand text-lg font-bold text-ocean-700 overflow-hidden"
                >
                  <span>H</span>
                </div>
                <div class="min-w-0">
                  <p class="text-[11px] font-semibold text-muted">Owned by</p>
                  <p
                    id="host-name"
                    class="text-sm font-extrabold text-ocean-950 truncate"
                  >
                    Host
                  </p>
                  <p class="text-[11px] text-emerald-700 font-semibold flex items-center gap-1 mt-0.5">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                    Identity Verified
                  </p>
                </div>
              </div>

              <div class="flex w-full shrink-0 items-center gap-2 sm:w-auto">
                <button
                  type="button"
                  id="view-host-profile-btn"
                  class="flex-1 rounded-full border border-line bg-white px-3 py-2 text-xs font-bold text-ink transition-colors hover:border-ocean-500 hover:bg-[#f6f8f9] cursor-pointer sm:flex-none"
                >
                  View profile
                </button>
                <button
                  type="button"
                  id="contact-host-btn"
                  class="flex-1 rounded-full bg-ocean-950 px-3.5 py-2 text-xs font-bold text-white transition-colors hover:bg-ocean-800 cursor-pointer sm:flex-none"
                >
                  Message
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Not Found State -->
      <div
        id="listing-error"
        class="hidden rounded-2xl border border-line bg-white p-12 text-center max-w-lg mx-auto"
      >
        <h2 class="text-2xl font-extrabold text-ocean-950">
          Listing not found
        </h2>
        <p class="mt-2 text-muted">
          This equipment listing may have been moved or removed by the host.
        </p>
        <a
          href="/browse"
          class="mt-6 inline-block rounded-full bg-accent px-6 py-3 text-sm font-bold text-white no-underline hover:brightness-95"
        >
          Browse other gear
        </a>
      </div>
    </main>

    <!-- Host Profile Modal -->
    <div
      id="host-profile-modal"
      class="auth-overlay fixed inset-0 z-50 hidden overflow-y-auto bg-ocean-950/60 p-3 backdrop-blur-[2px] sm:p-6"
      role="dialog"
      aria-modal="true"
      aria-labelledby="host-profile-title"
    >
      <div class="flex min-h-full items-center justify-center">
        <section class="auth-card flex max-h-[calc(100vh-1.5rem)] w-full max-w-3xl flex-col overflow-hidden rounded-3xl bg-white shadow-2xl sm:max-h-[min(90vh,900px)]">
          <header class="flex shrink-0 items-center justify-between border-b border-line px-5 py-4 sm:px-7">
            <div>
              <h2 id="host-profile-title" class="mt-0.5 text-lg font-extrabold text-ocean-950">Host profile</h2>
            </div>
            <button
              type="button"
              id="host-profile-close"
