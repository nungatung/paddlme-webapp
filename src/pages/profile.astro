---
import "../styles/global.css";
import AuthModal from "../components/AuthModal.astro";
import Footer from "../components/Footer.astro";
import ProfileApp from "../components/profile/ProfileApp";
import Nav from "../components/Nav.astro";

const site = "https://paddlme.tech/profile";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <title>My profile — Paddlme</title>
    <meta
      name="description"
      content="Manage your Paddlme profile, rentals, bookings, reviews and listings."
    />
    <link rel="canonical" href={site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#f6f8f9] font-sans text-ink antialiased">
    <Nav variant="solid" />

    <main class="mx-auto min-h-[70vh] max-w-[1120px] px-4 pb-20 pt-28 sm:px-6">
      <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="mt-1 text-[30px] font-extrabold tracking-[-0.03em] text-ocean-950">
            My profile
          </h1>
        </div>
        <button
          type="button"
          data-auth-signout
          class="cursor-pointer hidden rounded-full border border-line bg-white px-4 py-2.5 text-sm font-bold text-ink transition-colors hover:border-ocean-500 hover:bg-[#f6f8f9]"
        >
          Sign out
        </button>
      </div>

      <ProfileApp client:load />
    </main>

    <Footer />
    <AuthModal />
  </body>
</html>
